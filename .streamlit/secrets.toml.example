# Copy this file to .streamlit/secrets.toml (never commit that file), or paste these lines into the
# "Secrets" box under Advanced settings on Streamlit Community Cloud.

# Password of the first 'admin' account. Used only when the database is created for the first time.
ADMIN_PASSWORD = "Choose-A-Strong-Password-1"

# Leave DATABASE_URL out to use the local SQLite file (data/academic_risk.db).
# Local MySQL (XAMPP or MySQL Community Server):
# DATABASE_URL = "mysql://root:your_password@localhost:3306/academic_risk"
# TiDB Cloud Starter (free, MySQL-compatible, needs TLS):
# DATABASE_URL = "mysql://xxxxxxxx.root:your_password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/academic_risk?ssl=true"
